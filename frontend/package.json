{
  "name": "release-controller-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "vitest run --coverage",
    "test:contract": "node tests/ui-contract.cjs",
    "test:smoke": "node tests/ui-smoke.cjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "preview": "vite preview",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:smoke",
    "quality:ci": "npm run quality && npm run test:e2e"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "bpmn-js": "18.22.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  }
}
