APP_NAME=release-controller
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./release.db

# Deployment script bind address (runtime env file or shell override).
# Use the production VM's actual address when not binding to loopback.
HOST_IP=127.0.0.1
HOST_PORT=3100
DATA_DIR=

DRONE_SERVER=http://drone.example.test
DRONE_TOKEN=

DRONE_TIMEOUT_SECONDS=10
GITEA_SERVER=http://gitea.example.test
GITEA_TOKEN=
GITEA_TIMEOUT_SECONDS=10

# Which repositories a release promotes, in what order, and to what target are
# project settings now -- edit them under Projects, not here. On a first upgrade
# from v2.x, migration 20260902_0014 reads DRONE_FRONTEND_REPO_OWNER/NAME,
# DRONE_BACKEND_REPO_OWNER/NAME, the GITEA_* equivalents and DRONE_DEFAULT_TARGET
# once, to seed that first project from the existing configuration. Set them for
# that one upgrade if you are coming from v2.x; a fresh install does not need them
# and starts with an empty registry.

# v3.0 project registry. APP_SECRET_KEY encrypts the Drone/Gitea tokens stored
# in upstream_connections; production refuses to start without it. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes existing stored tokens unreadable -- the UI reports those
# connections as key_mismatch and they need re-entering.
APP_SECRET_KEY=
# Require a Gitea admin to change projects and connections. Leave false until
# you have confirmed at /api/v1/auth/me that the right people are flagged admin
# in Gitea, or you can lock yourself out of the settings pages.
PROJECT_ADMIN_WRITES=false

# The DRONE_*_REPO_* / GITEA_*_REPO_* variables above are still the live
# deployment configuration. Migration 20260902_0014 copies them into the project
# registry once, as the project "default"; nothing reads the registry yet.

# Register an OAuth2 application in Gitea with this callback URL.
AUTH_ENABLED=true
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
GITEA_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/auth/callback
AUTH_SESSION_HOURS=8
# Set true behind HTTPS in production. Local HTTP development requires false.
AUTH_COOKIE_SECURE=false
DEPLOYMENT_TIMEOUT_SECONDS=1800

# Persisted scheduler/background worker (keep one worker with the SQLite deployment)
# Complete the SMTP settings and migration first, then enable the worker.
BACKGROUND_WORKER_ENABLED=false
BACKGROUND_WORKER_POLL_SECONDS=5
SCHEDULER_BATCH_SIZE=20

# SMTP notification delivery. Leave SMTP_HOST empty to keep delivery disabled.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=release-controller@localhost
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TLS_VERIFY=false

# Optional PEM bundle for an internal CA mounted into the container.
SMTP_TLS_CA_FILE=
SMTP_TIMEOUT_SECONDS=10
SMTP_DEFAULT_RECIPIENTS=

# Comma-separated deployment targets that send the schedule-created notification.
SMTP_MANAGED_RECIPIENT_TARGETS=production
SMTP_MAX_ATTEMPTS=5
SMTP_RETRY_SECONDS=60
SMTP_CLAIM_TIMEOUT_SECONDS=300
# Maximum uploaded notification attachment size in bytes (default: 10 MiB).
NOTIFICATION_ATTACHMENT_MAX_BYTES=10485760

# Upstream resilience (v2.4). Reads are retried with jittered backoff; promote
# and create-release are never retried automatically because they are not
# idempotent -- an uncertain promote is reconciled instead.
DRONE_CONNECT_TIMEOUT_SECONDS=3
DRONE_WRITE_TIMEOUT_SECONDS=30
GITEA_CONNECT_TIMEOUT_SECONDS=3
GITEA_WRITE_TIMEOUT_SECONDS=30
UPSTREAM_RETRY_ATTEMPTS=3
UPSTREAM_RETRY_BASE_SECONDS=0.25
UPSTREAM_RETRY_MAX_SECONDS=2
